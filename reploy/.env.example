# =============================================================================
# 部署环境变量示例（复制成同目录下的 .env 再填真实值）
#
#   Windows : Copy-Item reploy\.env.example reploy\.env
#   Linux   : cp reploy/.env.example reploy/.env
#
# .env 已被 .gitignore 忽略，**禁止提交真实密码**；这里只放键名与注释。
#
# 取值优先级：进程环境变量 > .env > src/main/resources/application.yml 里的默认值
# 变量名规则：DB_* 四项与 application.yml 的 ${} 占位符同名；
#            其它配置用「大写 + 下划线」即可覆盖，例如 APP_JWT_SECRET 覆盖 app.jwt.secret、
#            SERVER_PORT 覆盖 server.port（Spring Boot 的宽松绑定会自动转换）。
# =============================================================================

# ---- 必填：PostgreSQL 连接（prod / postgres profile 使用）----
# 库与表由 reploy/sql/schema.sql 建立，见 reploy/sql/README.md
DB_URL=jdbc:postgresql://localhost:5432/webdesign
DB_USERNAME=postgres
# 留空会直接认证失败（服务端要求 SCRAM 密码），务必填写
DB_PASSWORD=

# ---- 可选 ----
# JWT 签名密钥；不填则用 application.yml 里的演示密钥，正式环境务必改掉
# APP_JWT_SECRET=

# 监听端口，等价于 --server.port=8080
# SERVER_PORT=8080

# 菜品图片目录（默认 uploads，相对启动目录）
# APP_UPLOAD_DIR=uploads
